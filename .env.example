# ==============================================================================
# SYNAPTIQ / NeuroSense-AI Environment Configuration Example
# ==============================================================================
# Copy this file to .env and provide your actual API keys and configurations:
#   cp .env.example .env
#
# DO NOT commit real secrets or .env to version control!
# ==============================================================================

# [REQUIRED] Groq Cloud API Key
# Used for LLM clinical explanations, multilingual chatbot, and Whisper audio transcription.
# Obtain a free/developer key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# [OPTIONAL] FFmpeg and FFprobe Binaries
# Custom paths to ffmpeg/ffprobe executables if not already present in system PATH.
# Example on Linux/macOS: /usr/local/bin/ffmpeg
# Example on Windows: C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=
FFPROBE_PATH=
